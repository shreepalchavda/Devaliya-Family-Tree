{
  "name": "family-tree",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"PUBLIC,ADMIN\" -c \"cyan,magenta\" \"npm run dev:public\" \"npm run dev:admin\"",
    "dev:public": "vite --port 5173",
    "dev:admin": "vite --config vite.admin.config.js --port 5174",
    "build": "vite build",
    "build:public": "vite build",
    "build:admin": "vite build --config vite.admin.config.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
