rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // 1. FAMILIES COLLECTION
    // Public visitors can read. Writes require valid structure and constraints.
    match /families/{familyId} {
      allow read: if true;
      
      allow create: if isValidString(request.resource.data.headFullName, 2, 120)
                    && isValidString(request.resource.data.originalVillage, 1, 120);

      allow update: if (request.resource.data.headFullName == null || isValidString(request.resource.data.headFullName, 2, 120))
                    && (request.resource.data.originalVillage == null || isValidString(request.resource.data.originalVillage, 1, 120));

      allow delete: if true;
    }

    // 2. MEMBERS COLLECTION
    // Public visitors can read. Writes require valid member data.
    match /members/{memberId} {
      allow read: if true;

      allow create: if isValidString(request.resource.data.fullName, 2, 120)
                    && isValidString(request.resource.data.familyId, 1, 120);

      allow update: if (request.resource.data.fullName == null || isValidString(request.resource.data.fullName, 2, 120));

      allow delete: if true;
    }

    // 3. ADMINS COLLECTION
    // Strictly protected: Only authenticated users can access admin records
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }

    // Default rule: block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
